{
  "uid": "price-tracker",
  "title": "Price Tracker",
  "tags": [
    "price-tracker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
