# База даних (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=tracker_db
POSTGRES_PORT=5432

# Кеш (Redis)
REDIS_PORT=6379

# Брокер черг (RabbitMQ)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Порти мікросервісів
CORE_API_PORT=8000
SCRAPER_PORT=8001
NOTIFIER_PORT=8002

# Ембеддинги (необов'язково, є значення за замовчуванням)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
